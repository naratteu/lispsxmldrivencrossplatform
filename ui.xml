<?xml version="1.0" encoding="utf-8"?>
<!-- UI 명세 — 색과 부품. 여기서 플랫폼별 네이티브 UI 코드가 생성된다(gen/).
     요소는 row · box · dot · label 넷뿐이고, 값은 아래 셋 중 하나다.
       이름              선언한 prop 이나 color
       글자 그대로        숫자, #RRGGBB(#AARRGGBB), true/false, '따옴표 글자'
       조건 ? 값 : 값     조건은 flag prop -->
<ui>
  <color name="bar" value="#24527A"/>
  <color name="bar-deep" value="#1B3F5E"/>
  <color name="page" value="#FDFDFB"/>
  <color name="text-primary" value="#1A1A1A"/>
  <color name="text-secondary" value="#6B7280"/>
  <color name="on-bar" value="#FFFFFF"/>
  <color name="on-bar-dim" value="#B3FFFFFF"/>
  <color name="on-bar-faint" value="#66FFFFFF"/>
  <color name="live" value="#4ADE80"/>
  <color name="blue" value="#3B82C4"/>
  <color name="green" value="#2F9E77"/>
  <color name="orange" value="#E08A1E"/>
  <color name="violet" value="#7A5AF8"/>

  <component name="home-mark" doc="앱 표시 — 누르면 홈">
    <event name="clicked"/>
    <box padding="10" tap="clicked">
      <box padding="5" radius="5" fill="on-bar">
        <box padding="5" radius="2" fill="bar"/>
      </box>
    </box>
  </component>

  <component name="tab-header" doc="탭 — 보고 있는 탭만 바탕이 있고 ✕ 로 닫는다">
    <prop name="title" type="text"/>
    <prop name="accent" type="color"/>
    <prop name="active" type="flag"/>
    <event name="clicked"/>
    <event name="close-clicked"/>
    <box padding="14 6 8 6" radius="8" fill="active ? page : #00000000" tap="clicked">
      <row spacing="8">
        <dot size="8" fill="active ? accent : on-bar-dim"/>
        <label text="title" size="14" bold="active" color="active ? text-primary : on-bar"/>
        <label text="'✕'" size="13" color="text-secondary" tap="close-clicked" visible="active"/>
      </row>
    </box>
  </component>

  <component name="bar-button" doc="바의 기호 버튼(+ ↻) — 꺼지면 흐리게">
    <prop name="glyph" type="text"/>
    <prop name="on" type="flag"/>
    <event name="clicked"/>
    <box padding="8 4">
      <label text="glyph" size="20" color="on ? on-bar : on-bar-faint" tap="clicked"/>
    </box>
  </component>

  <component name="status-chip" doc="상태 표시 — 점과 글자">
    <prop name="text" type="text"/>
    <prop name="on" type="flag"/>
    <box padding="10 4" radius="13" fill="bar-deep">
      <row spacing="6">
        <dot size="8" fill="on ? live : on-bar-dim"/>
        <label text="text" size="12" color="on-bar"/>
      </row>
    </box>
  </component>
</ui>
