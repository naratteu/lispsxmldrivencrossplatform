;;; 두 플랫폼 모두 C# 이라 같은 부분 — 이름 바꾸기, 값 → C# 식, 색 · prop · event 선언, 보기 모음
(in-package :ui-gen)

(defun line (fmt &rest args)
  "한 줄 찍기: (line \"var ~a = 1;\" 이름)"
  (format t "~?~%" fmt args))

(defun join (strings separator)
  (with-output-to-string (out)
    (loop for (s . more) on strings
          do (write-string s out)
             (when more (write-string separator out)))))

(defun pascal (name)
  "tab-header → TabHeader"
  (remove #\- (string-capitalize (symbol-name name))))

(defun field (name)
  "close-clicked → _closeClicked"
  (let ((p (pascal name)))
    (format nil "_~a~a" (char-downcase (char p 0)) (subseq p 1))))

(defun cs-string (string)
  (with-output-to-string (out)
    (write-char #\" out)
    (loop for c across string
          do (when (member c '(#\\ #\")) (write-char #\\ out))
             (write-char c out))
    (write-char #\" out)))

(defun cs-value (value color-maker)
  "검사를 지난 값 → C# 식. 색을 만드는 함수 이름만 플랫폼마다 다르다(인자는 둘 다 a r g b)"
  (ecase (first value)
    (num (format nil "~a" (second value)))
    (text (cs-string (second value)))
    (flag (if (second value) "true" "false"))
    (color (format nil "~a(~{~a~^, ~})" color-maker (rest value)))
    (token (format nil "Tokens.~a" (pascal (second value))))
    (prop (field (second value)))
    (if (destructuring-bind (condition a b) (rest value)
          (format nil "(~a ? ~a : ~a)" (field condition) (cs-value a color-maker) (cs-value b color-maker))))))

(defun cs-choice (flag when-true when-false color-maker)
  "flag 값에 따라 둘 중 하나 — 값이 정해져 있으면 고른 쪽만 남긴다"
  (cond ((equal flag '(flag t)) when-true)
        ((equal flag '(flag nil)) when-false)
        (t (format nil "~a ? ~a : ~a" (cs-value flag color-maker) when-true when-false))))

(defun print-header (usings)
  (line "// <auto-generated/> ui.xml 에서 생성됨 — 고치려면 명세를 고친다")
  (line "#nullable enable")
  (dolist (u usings) (line "using ~a;" u))
  (line "namespace Ui;"))

(defun print-tokens (spec color-maker)
  "색 이름표"
  (line "")
  (line "public static class Tokens")
  (line "{")
  (dolist (color (spec-colors spec))
    (line "    public static readonly Color ~a = ~a(~{~a~^, ~});" (pascal (first color)) color-maker (rest color)))
  (line "}"))

(defun print-members (component)
  "prop · event 는 모두 required — 명세에 하나 더하면, 이 부품을 쓰는 곳이 채울 때까지 컴파일되지 않는다"
  (loop for (name type) in (component-props component)
        for cs-type = (ecase type (text "string") (color "Color") (flag "bool"))
        for initial = (ecase type (text "\"\"") (color "default") (flag "false"))
        do (line "    ~a ~a = ~a;" cs-type (field name) initial)
           (line "    public required ~a ~a { get => ~a; set { ~a = value; Render(); } }"
                 cs-type (pascal name) (field name) (field name)))
  (dolist (name (component-events component))
    (line "    public required Action ~a { get; init; }" (pascal name))))

(defun print-examples (spec color-maker view-type parameter new)
  "명세의 example 들을 실제 부품으로 — 플랫폼끼리, 그리고 프리뷰와 견주어 보는 데 쓴다.
new 는 부품 이름을 받아 \"new TabHeader(context)\" 같은 생성 식을 준다"
  (line "")
  (line "/// 명세의 example 모음 — (부품 이름, 바탕색, 부품)")
  (line "public static class Examples")
  (line "{")
  (line "    public static IEnumerable<(string Name, Color Backdrop, ~a View)> All(~a)" view-type parameter)
  (line "    {")
  (dolist (component (spec-components spec))
    (dolist (example (component-examples component))
      (line "        yield return (~a, ~a, ~a { ~a });"
            (cs-string (string-downcase (symbol-name (component-name component))))
            (cs-value (component-backdrop component) color-maker)
            (funcall new (pascal (component-name component)))
            (join (append (loop for (name value) in (rest example)
                                collect (format nil "~a = ~a" (pascal name) (cs-value value color-maker)))
                          (loop for event in (component-events component)
                                collect (format nil "~a = () => { }" (pascal event))))
                  ", "))))
  (line "        yield break;")
  (line "    }")
  (line "}"))
