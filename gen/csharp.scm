;;; 두 플랫폼 모두 C# 이라 같은 부분 — 이름 바꾸기, 값 → C# 식, 색 · prop · event 선언
(define-module (csharp)
  #:use-module (spec)
  #:use-module (ice-9 match)
  #:export (line pascal field cs-value cs-choice
            print-header print-tokens print-members))

;; 한 줄 찍기: (line "var ~a = 1;" 이름)
(define (line fmt . args)
  (apply format #t fmt args)
  (newline))

;; tab-header → TabHeader
(define (pascal name)
  (string-concatenate (map string-capitalize (string-split (symbol->string name) #\-))))

;; close-clicked → _closeClicked
(define (field name)
  (let ((p (pascal name)))
    (string-append "_" (string-downcase (substring p 0 1)) (substring p 1))))

(define (cs-string s)
  (string-append "\"" (string-concatenate
                       (map (lambda (c)
                              (case c
                                ((#\\) "\\\\")
                                ((#\") "\\\"")
                                (else (string c))))
                            (string->list s)))
                 "\""))

;; 검사를 지난 값 → C# 식. 색을 만드는 함수 이름만 플랫폼마다 다르다(인자는 둘 다 a r g b)
(define (cs-value value color-maker)
  (match value
    (('num n) (number->string n))
    (('text s) (cs-string s))
    (('flag b) (if b "true" "false"))
    (('color a r g b) (format #f "~a(~a, ~a, ~a, ~a)" color-maker a r g b))
    (('token name) (string-append "Tokens." (pascal name)))
    (('prop name) (field name))
    (('if condition a b)
     (format #f "(~a ? ~a : ~a)" (field condition) (cs-value a color-maker) (cs-value b color-maker)))))

;; flag 값에 따라 둘 중 하나 — 값이 정해져 있으면 고른 쪽만 남긴다
(define (cs-choice flag when-true when-false color-maker)
  (match flag
    (('flag #t) when-true)
    (('flag #f) when-false)
    (_ (format #f "~a ? ~a : ~a" (cs-value flag color-maker) when-true when-false))))

(define (print-header usings)
  (line "// <auto-generated/> ui.xml 에서 생성됨 — 고치려면 명세를 고친다")
  (line "#nullable enable")
  (for-each (lambda (u) (line "using ~a;" u)) usings)
  (line "namespace Ui;"))

;; 색 이름표
(define (print-tokens spec color-maker)
  (line "")
  (line "public static class Tokens")
  (line "{")
  (for-each (match-lambda
              ((name a r g b)
               (line "    public static readonly Color ~a = ~a(~a, ~a, ~a, ~a);" (pascal name) color-maker a r g b)))
            (spec-colors spec))
  (line "}"))

;; prop · event 는 모두 required — 명세에 하나 더하면, 이 부품을 쓰는 곳이 채울 때까지 컴파일되지 않는다
(define (print-members component)
  (for-each (match-lambda
              ((name type)
               (let ((cs-type (case type ((text) "string") ((color) "Color") ((flag) "bool")))
                     (initial (case type ((text) "\"\"") ((color) "default") ((flag) "false"))))
                 (line "    ~a ~a = ~a;" cs-type (field name) initial)
                 (line "    public required ~a ~a { get => ~a; set { ~a = value; Render(); } }"
                       cs-type (pascal name) (field name) (field name)))))
            (component-props component))
  (for-each (lambda (name)
              (line "    public required Action ~a { get; init; }" (pascal name)))
            (component-events component)))
