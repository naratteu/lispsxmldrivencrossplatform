;;; Android 뷰 생성 — 요소 하나가 문장 여러 줄이 된다(뷰를 만들고, 설정하고, 부모에 붙인다)
(define-module (android)
  #:use-module (spec)
  #:use-module (csharp)
  #:use-module (ice-9 match)
  #:export (print-android))

(define (value v) (cs-value v "Color.Argb"))
(define (px v) (format #f "Px(~a)" (if (number? v) v (value v))))

;; 부모가 자식에게 줄 크기 — dot 만 정해진 크기, 나머지는 내용만큼
(define (size-of node)
  (if (eq? (tag node) 'dot)
      (format #f "~a, ~a" (px (attr node 'size)) (px (attr node 'size)))
      "Wrap, Wrap"))

;; 요소의 문장들을 찍고, 그 뷰를 담은 변수 이름을 돌려준다. fresh 는 새 변수 이름을 주는 함수
(define (statements node fresh)
  (let ((a (lambda (name) (attr node name)))
        (v (fresh)))
    (case (tag node)
      ((row)
       (line "        var ~a = new LinearLayout(context) { Orientation = Orientation.Horizontal };" v)
       (line "        ~a.SetGravity(GravityFlags.CenterVertical);" v)
       (let loop ((kids (children node)) (first? #t))
         (unless (null? kids)
           (let ((kid (statements (car kids) fresh)))
             (line "        ~a.AddView(~a, new LinearLayout.LayoutParams(~a)~a);"
                   v kid (size-of (car kids))
                   ;; 둘째부터 간격만큼 띄운다
                   (if first? "" (format #f " { LeftMargin = ~a }" (px (a 'spacing))))))
           (loop (cdr kids) #f))))
      ((box)
       (line "        var ~a = new FrameLayout(context);" v)
       (match (a 'padding)
         (('padding l t r b)
          (line "        ~a.SetPadding(~a, ~a, ~a, ~a);" v (px l) (px t) (px r) (px b))))
       (line "        ~a.Background = Fill(~a, ~a, oval: false);" v (value (a 'fill)) (px (a 'radius)))
       (for-each (lambda (child)
                   (let ((kid (statements child fresh)))
                     (line "        ~a.AddView(~a, new FrameLayout.LayoutParams(~a) { Gravity = GravityFlags.Center });"
                           v kid (size-of child))))
                 (children node)))
      ((dot)
       (line "        var ~a = new View(context) { Background = Fill(~a, 0, oval: true) };" v (value (a 'fill))))
      ((label)
       (line "        var ~a = new TextView(context) { Text = ~a };" v (value (a 'text)))
       (line "        ~a.SetTextSize(ComplexUnitType.Dip, ~a);" v (value (a 'size)))
       (line "        ~a.SetTextColor(~a);" v (value (a 'color)))
       (line "        ~a.SetTypeface(null, ~a);" v (cs-choice (a 'bold) "TypefaceStyle.Bold" "TypefaceStyle.Normal" "Color.Argb"))
       (line "        ~a.SetIncludeFontPadding(false);" v)))
    (unless (equal? (a 'visible) '(flag #t))
      (line "        ~a.Visibility = ~a ? ViewStates.Visible : ViewStates.Gone;" v (value (a 'visible))))
    (when (a 'tap)
      (line "        ~a.Click += (_, _) => ~a();" v (pascal (a 'tap))))
    v))

(define (print-component component)
  (let* ((name (pascal (component-name component)))
         (root (component-root component))
         ;; v1, v2, ... 를 차례로 주는 함수
         (count 0)
         (fresh (lambda () (set! count (+ count 1)) (format #f "v~a" count))))
    (line "")
    (line "/// ~a" (component-doc component))
    (line "public sealed class ~a : FrameLayout" name)
    (line "{")
    (print-members component)
    (line "")
    (line "    public ~a(Context context) : base(context) => Render();" name)
    (line "")
    (line "    void Render()")
    (line "    {")
    (line "        var context = Context!;")
    (line "        RemoveAllViews();")
    (let ((v (statements root fresh)))
      (line "        AddView(~a, new LayoutParams(~a) { Gravity = GravityFlags.Center });" v (size-of root)))
    (line "    }")
    (line "")
    (line "    const int Wrap = ViewGroup.LayoutParams.WrapContent;")
    (line "    int Px(double dp) => (int)Math.Round(dp * Resources!.DisplayMetrics!.Density);")
    (line "    static GradientDrawable Fill(Color color, int radius, bool oval)")
    (line "    {")
    (line "        var fill = new GradientDrawable();")
    (line "        if (oval) fill.SetShape(ShapeType.Oval); else fill.SetCornerRadius(radius);")
    (line "        fill.SetColor(color);")
    (line "        return fill;")
    (line "    }")
    (line "}")))

(define (print-android spec)
  (print-header '("Android.Content" "Android.Graphics" "Android.Graphics.Drawables"
                  "Android.Util" "Android.Views" "Android.Widget"))
  (print-tokens spec "Color.Argb")
  (for-each print-component (spec-components spec)))
