<Project>
  <!-- 앱 프로젝트가 가져다 쓴다: 명세(ui.xml)와 생성기(gen/*.lisp)를 소스 생성기에 넘긴다.
       앱은 UiTarget 에 avalonia 나 android 를 적는다. 먼저 `dotnet tool restore`(dotcl) 를 한 번 해야 한다 -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)SourceGen/SourceGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)../ui.xml;$(MSBuildThisFileDirectory)../gen/*.lisp" />
    <CompilerVisibleProperty Include="UiTarget" />
  </ItemGroup>
  <!-- 생성된 C# 을 obj/gen/ 에 남겨 볼 수 있게 한다(저장소에는 두지 않는다) -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)/obj/gen</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
</Project>
